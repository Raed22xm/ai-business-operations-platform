# Ports configuration (defaults to 3080/5280 to prevent conflicts with local dev servers)
FRONTEND_PORT=3080
BACKEND_PORT=5280
DB_PORT=5432

# Database configuration
DB_PASSWORD=aibusiness_secure_pass_123

# Workspace authentication credentials
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# JWT signing key (minimum 64 characters recommended for HMAC-SHA256)
JWT_SIGNING_KEY=dev-super-secret-jwt-signing-key-minimum-64-characters-long-operations-hub-platform

# Cookie security (set to true if serving behind HTTPS)
AUTH_COOKIE_SECURE=false

# Optional OpenAI integration (if omitted, mock client is used)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
